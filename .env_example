# Configurações do Banco de Dados PostgreSQL
DB_USER=postgres
DB_PASSWORD=troque_esta_senha
DB_NAME=easypark
# Em produção via Docker Compose, o docker-compose.yml já aponta para postgres:5432 por padrão
# DB_HOST=postgres
# DB_PORT=5432
# Estratégia do Hibernate em produção (update, validate ou none)
DB_SCHEMA_STRATEGY=update
# Script inicial de carga (use 'import.sql' no primeiro deploy ou 'no-file' para desativar)
DB_SQL_LOAD_SCRIPT=import.sql

# URL Pública da Aplicação (na EC2, coloque http://SEU_IP_PUBLICO_EC2)
APP_BASE_URL=http://localhost:8080
APP_HTTP_PORT=80

# Chave Secreta de Criptografia (AES-GCM 32 caracteres / HMAC)
SECRET_KEY=
HMAC_SECRET=

# Asaas
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Ngrok (Apenas para desenvolvimento local)
NGROK_TOKEN=
NGROK_DOMAIN=

# SMTP
MAILER_HOST=
MAILER_PORT=587
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_FROM=
